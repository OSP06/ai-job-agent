# ─── AI Providers ────────────────────────────────────────────────────────────
# OpenAI: required for resume embeddings. Also handles LLM if GROQ_API_KEY is absent.
# Get key at platform.openai.com/api-keys — embeddings cost ~$0.01/month at 30 jobs/day.
OPENAI_API_KEY=sk-...

# Groq (optional, free — no credit card): routes job parsing + outreach to Llama-3 instead of GPT.
# Get key at console.groq.com — free tier gives 1,000 req/day on llama-3.3-70b.
# Recommended: set both keys. Groq handles LLM (free), OpenAI handles embeddings (~$0.01/month).
GROQ_API_KEY=

# ─── Gmail (OAuth2) ──────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=backend/credentials.json
GMAIL_TOKEN_PATH=backend/token.json
GMAIL_SENDER_EMAIL=you@gmail.com

# For deployed environments (Railway/Render): paste contents of token.json here.
# Run `python scripts/gmail_auth.py` locally to generate this.
GMAIL_TOKEN_JSON=

# ─── Hunter.io (optional — recruiter email finder) ───────────────────────────
HUNTER_API_KEY=

# ─── Notion (optional) ───────────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ─── Storage ─────────────────────────────────────────────────────────────────
DB_PATH=backend/storage/jobs.db
RESUMES_DIR=backend/resumes

# ─── Agent settings ──────────────────────────────────────────────────────────
MATCH_SCORE_THRESHOLD=0.70        # 0.0–1.0; outreach only generated above this
FOLLOWUP_DAY_1=7                  # days after application for first follow-up
FOLLOWUP_DAY_2=14                 # days after application for final follow-up

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
