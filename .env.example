# ─── AI Providers ────────────────────────────────────────────────────────────
# OpenAI: required for resume embeddings (text-embedding-3-small).
# Cost: ~$0.01/month at 30 jobs/day. Get key at platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Groq (recommended, free): routes job parsing + outreach to Llama-3 instead of GPT.
# Get key at console.groq.com — free tier gives 1,000 req/day on llama-3.3-70b.
# If omitted, OpenAI handles both embeddings and LLM (higher cost).
GROQ_API_KEY=

# ─── Contact Discovery ────────────────────────────────────────────────────────
# Hunter.io: finds recruiter / HR emails for outreach. Free tier = 25 searches/month.
# Get key at hunter.io/api-keys. Leave blank to skip contact discovery.
HUNTER_API_KEY=

# ─── Notion (optional — passive job tracker) ─────────────────────────────────
# Creates a row in a Notion DB for every captured job (title, score, outreach email).
# 1. Go to notion.so/my-integrations → New integration → copy the token
# 2. Create a DB in Notion, share it with your integration
# 3. Copy the DB ID from the URL: notion.so/username/{DATABASE_ID}?v=...
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ─── Security ─────────────────────────────────────────────────────────────────
# Optional: set a secret to protect write endpoints (X-Api-Key header).
# Leave blank to run without auth (fine for local use).
API_KEY=

# ─── Storage ─────────────────────────────────────────────────────────────────
DB_PATH=backend/storage/jobs.db
RESUMES_DIR=backend/resumes

# ─── Agent Settings ───────────────────────────────────────────────────────────
MATCH_SCORE_THRESHOLD=0.70        # 0.0–1.0; outreach only generated above this
FOLLOWUP_DAY_1=7                  # days after application for first follow-up
FOLLOWUP_DAY_2=14                 # days after application for final follow-up
SCHEDULER_TIMEZONE=America/New_York

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_FILE=logs/agent.log        # optional: write logs to a file (local dev only)
